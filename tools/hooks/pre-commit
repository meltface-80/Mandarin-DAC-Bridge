#!/bin/sh
# The fast gates, before every commit (docs/quality-plan.md). Active with:
#   git config core.hooksPath tools/hooks
# CI runs these and the full tests on macOS, Windows and Linux. Never bypass it (--no-verify): fix what it says.
set -e
cd "$(git rev-parse --show-toplevel)"
python3 tools/quality/length.py
python3 -m unittest discover -s tools/quality -q
