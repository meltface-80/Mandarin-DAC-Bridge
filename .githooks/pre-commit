#!/usr/bin/env bash
# Pre-commit gate (dev/quality.md): the fast half of tools/check.sh — file length, the gates' own
# tests, and the build with the analyzers. The full suite runs in CI (checks.yml) on macOS, Windows
# and Linux, and blocks the release.
#
# Turned on per clone with:  git config core.hooksPath .githooks
# (the Claude Code session hook in .claude/settings.json does it for you). Never --no-verify.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
tools/check.sh gates
