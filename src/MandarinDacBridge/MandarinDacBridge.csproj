<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Mandarin DAC Bridge: holds each USB DAC exclusively and offers it to
    Audirvana and Mandarin as a UPnP renderer. Built ahead of time to one
    native program (Native AOT), so nothing of .NET is needed where it runs;
    the page is inside it. See README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>mandarin-dac-bridge</AssemblyName>
    <RootNamespace>MandarinDacBridge</RootNamespace>
    <Version>1.0.0</Version>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <OptimizationPreference>Speed</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <!-- One small heap, collected without a background thread: the audio
         path allocates next to nothing, so the collector rarely runs. -->
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NuGetAudit>false</NuGetAudit>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Page/**" LogicalName="Page/%(RecursiveDir)%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="MandarinDacBridge.Tests" />
  </ItemGroup>
  <!-- macOS: an Info.plist inside the program, so macOS can ask (and name it) for the microphone (reading back the
       DAC Bridge output) and for Apple Events (following the Music and Spotify apps). -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('osx'))">
    <LinkerArg Include="-Wl,-sectcreate,__TEXT,__info_plist,$(MSBuildThisFileDirectory)Mac/Info.plist" />
  </ItemGroup>
</Project>
