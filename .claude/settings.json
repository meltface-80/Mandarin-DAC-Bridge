{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "cd \"$CLAUDE_PROJECT_DIR\" && git config core.hooksPath .githooks" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{ "type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/quality/edit_hook.py\"", "timeout": 10 }]
      }
    ]
  }
}
